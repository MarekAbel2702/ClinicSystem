<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MediClinic</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ClinicSystem.styles.css" asp-append-version="true" />
</head>

<body>
    <div class="app-shell">
        <aside class="sidebar">
            <div class="brand">
                <div class="brand-icon">
                    <i class="bi bi-heart-pulse"></i>
                </div>
                <div>
                    <h2>MediClinic</h2>
                    <span>System przychodni</span>
                </div>
            </div>

            <nav class="sidebar-nav">
                <a asp-controller="Dashboard" asp-action="Index">
                    <i class="bi bi-speedometer2"></i>
                    Dashboard
                </a>

                <a asp-controller="Patients" asp-action="Index">
                    <i class="bi bi-people"></i>
                    Pacjenci
                </a>

                <a asp-controller="Doctors" asp-action="Index">
                    <i class="bi bi-person-badge"></i>
                    Lekarze
                </a>

                <a asp-controller="Appointments" asp-action="Index">
                    <i class="bi bi-calendar2-week"></i>
                    Wizyty
                </a>

                <a asp-controller="Specializations" asp-action="Index">
                    <i class="bi bi-diagram-3"></i>
                    Specjalizacje
                </a>

                @if (User.IsInRole("Administrator"))
                {
                    <a asp-controller="Users" asp-action="Index">
                        <i class="bi bi-shield-lock"></i>
                        Użytkownicy
                    </a>
                }

                <a asp-controller="Home" asp-action="Index">
                    <i class="bi bi-globe2"></i>
                    Strona publiczna
                </a>
            </nav>

            <div class="sidebar-footer">
                <div class="user-box">
                    <div class="user-avatar">
                        <i class="bi bi-person"></i>
                    </div>

                    <div>
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <strong>@User.Identity.Name</strong>
                            <span>Zalogowany użytkownik</span>
                        }
                        else
                        {
                            <strong>Gość</strong>
                            <span>Niezalogowany</span>
                        }
                    </div>
                </div>

                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <form asp-controller="Account" asp-action="Logout" method="post" class="mt-3">
                        <button type="submit" class="btn btn-light w-100">
                            <i class="bi bi-box-arrow-right"></i>
                            Wyloguj
                        </button>
                    </form>
                }
            </div>
        </aside>

        <main class="main-content">
            <header class="topbar">
                <div>
                    <span class="topbar-label">System informatyczny</span>
                    <strong>Przychodnia lekarska</strong>
                </div>

                <div class="topbar-actions">
                    <div class="search-box">
                        <i class="bi bi-search"></i>
                        <input type="text" placeholder="Szukaj w systemie..." />
                    </div>

                    <button class="icon-btn" type="button">
                        <i class="bi bi-bell"></i>
                    </button>

                    <button class="icon-btn" type="button">
                        <i class="bi bi-gear"></i>
                    </button>
                </div>
            </header>

            <section class="content-wrapper">
                @RenderBody()
            </section>
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>