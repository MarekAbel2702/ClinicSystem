@model ClinicSystem.Models.Specialization

@{
    ViewData["Title"] = "Usuń specjalizację";
}

<div class="page-header">
    <div>
        <h1>Usuń specjalizację</h1>
        <p>Potwierdź usunięcie specjalizacji z systemu.</p>
    </div>

    <div class="header-actions">
        <a asp-action="Index" class="btn btn-light">
            <i class="bi bi-arrow-left"></i>
            Powrót
        </a>
    </div>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show custom-alert" role="alert">
        <i class="bi bi-exclamation-triangle"></i>
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="danger-card">
    <div class="danger-icon">
        <i class="bi bi-exclamation-triangle"></i>
    </div>

    <div>
        <h2>Czy na pewno chcesz usunąć tę specjalizację?</h2>
        <p>
            Operacja jest nieodwracalna. Specjalizacji nie można usunąć,
            jeśli są do niej przypisani lekarze.
        </p>
    </div>
</div>

<div class="info-card mt-4">
    <div class="info-list">
        <div class="info-row">
            <span>Nazwa</span>
            <strong>@Model.Name</strong>
        </div>

        <div class="info-row">
            <span>Liczba lekarzy</span>
            <strong>@Model.Doctors.Count</strong>
        </div>

        <div class="info-row">
            <span>Opis</span>
            <strong>
                @(string.IsNullOrWhiteSpace(Model.Description) ? "Brak opisu" : Model.Description)
            </strong>
        </div>
    </div>

    <form asp-action="Delete" method="post" class="form-actions">
        <input type="hidden" asp-for="Id" />

        <a asp-action="Index" class="btn btn-light">
            Anuluj
        </a>

        <button type="submit" class="btn btn-danger">
            <i class="bi bi-trash"></i>
            Usuń specjalizację
        </button>
    </form>
</div>