@{
    ViewData["Title"] = "Brak profilu pacjenta";
    Layout = "~/Views/Shared/_PublicLayout.cshtml";
}

<section class="auth-section">
    <div class="auth-card">
        <div class="auth-header">
            <div class="auth-icon danger-auth-icon">
                <i class="bi bi-person-x"></i>
            </div>

            <h1>Brak profilu pacjenta</h1>

            <p>
                Twoje konto nie jest jeszcze powiązane z kartoteką pacjenta.
                Skontaktuj się z recepcją przychodni.
            </p>
        </div>

        <a asp-controller="Home" asp-action="Index" class="btn btn-primary w-100">
            Wróć na stronę główną
        </a>
    </div>
</section>