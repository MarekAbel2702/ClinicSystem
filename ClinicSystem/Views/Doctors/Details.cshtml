@model ClinicSystem.Models.Doctor

@{
    ViewData["Title"] = "Szczegóły lekarza";
}

<div class="page-header">
    <div>
        <h1>Dr @Model.FirstName @Model.LastName</h1>
        <p>Profil lekarza, dane zawodowe oraz najbliższe wizyty.</p>
    </div>

    <div class="header-actions">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
            <i class="bi bi-pencil"></i>
            Edytuj
        </a>

        <a asp-controller="Appointments" asp-action="Create" asp-route-doctorId="@Model.Id" class="btn btn-light">
            <i class="bi bi-calendar-plus"></i>
            Umów wizytę
        </a>

        <a asp-action="Index" class="btn btn-light">
            <i class="bi bi-arrow-left"></i>
            Powrót
        </a>
    </div>
</div>

<div class="details-grid">
    <div class="profile-card doctor-profile-card">
        <div class="profile-avatar">
            @Model.FirstName.Substring(0, 1)@Model.LastName.Substring(0, 1)
        </div>

        <h2>Dr @Model.FirstName @Model.LastName</h2>
        <p>@(Model.Specialization?.Name ?? "Brak specjalizacji")</p>

        @if (Model.IsActive)
        {
            <span class="large-status active">
                <i class="bi bi-check-circle"></i>
                Lekarz aktywny
            </span>
        }
        else
        {
            <span class="large-status inactive">
                <i class="bi bi-x-circle"></i>
                Lekarz nieaktywny
            </span>
        }

        <div class="profile-tags mt-3">
            <span><i class="bi bi-credit-card-2-front"></i> PWZ: @Model.LicenseNumber</span>
            <span><i class="bi bi-door-open"></i> Gabinet: @(string.IsNullOrWhiteSpace(Model.OfficeNumber) ? "Brak" : Model.OfficeNumber)</span>
        </div>
    </div>

    <div class="info-card">
        <div class="panel-card-header">
            <div>
                <h3>Dane lekarza</h3>
                <p>Informacje zapisane w profilu lekarza.</p>
            </div>
            <i class="bi bi-person-lines-fill panel-icon"></i>
        </div>

        <div class="info-list">
            <div class="info-row">
                <span>Imię</span>
                <strong>@Model.FirstName</strong>
            </div>

            <div class="info-row">
                <span>Nazwisko</span>
                <strong>@Model.LastName</strong>
            </div>

            <div class="info-row">
                <span>Specjalizacja</span>
                <strong>@(Model.Specialization?.Name ?? "Brak")</strong>
            </div>

            <div class="info-row">
                <span>Numer PWZ</span>
                <strong>@Model.LicenseNumber</strong>
            </div>

            <div class="info-row">
                <span>Telefon</span>
                <strong>@(string.IsNullOrWhiteSpace(Model.PhoneNumber) ? "Brak" : Model.PhoneNumber)</strong>
            </div>

            <div class="info-row">
                <span>E-mail</span>
                <strong>@(string.IsNullOrWhiteSpace(Model.Email) ? "Brak" : Model.Email)</strong>
            </div>

            <div class="info-row">
                <span>Gabinet</span>
                <strong>@(string.IsNullOrWhiteSpace(Model.OfficeNumber) ? "Brak" : Model.OfficeNumber)</strong>
            </div>

            <div class="info-row">
                <span>Status</span>
                <strong>@(Model.IsActive ? "Aktywny" : "Nieaktywny")</strong>
            </div>
        </div>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Description))
{
    <div class="panel-card mt-4">
        <div class="panel-card-header">
            <div>
                <h3>Opis lekarza</h3>
                <p>Zakres konsultacji, doświadczenie i dodatkowe informacje.</p>
            </div>
            <i class="bi bi-file-medical panel-icon"></i>
        </div>

        <p class="description-text">@Model.Description</p>
    </div>
}

<div class="panel-card mt-4">
    <div class="panel-card-header">
        <div>
            <h3>Wizyty lekarza</h3>
            <p>Najbliższe i ostatnie wizyty przypisane do lekarza.</p>
        </div>
        <i class="bi bi-calendar2-week panel-icon"></i>
    </div>

    @if (Model.Appointments.Any())
    {
        <div class="table-responsive">
            <table class="table modern-table">
                <thead>
                    <tr>
                        <th>Data</th>
                        <th>Pacjent</th>
                        <th>Powód</th>
                        <th>Status</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var appointment in Model.Appointments.OrderByDescending(a => a.AppointmentDate))
                    {
                        <tr>
                            <td>@appointment.AppointmentDate.ToString("dd.MM.yyyy HH:mm")</td>
                            <td>@appointment.Patient?.FirstName @appointment.Patient?.LastName</td>
                            <td>@appointment.Reason</td>
                            <td>
                                @if (appointment.Status == ClinicSystem.Models.AppointmentStatus.Scheduled)
                                {
                                    <span class="badge bg-primary">Zaplanowana</span>
                                }
                                else if (appointment.Status == ClinicSystem.Models.AppointmentStatus.Completed)
                                {
                                    <span class="badge bg-success">Zrealizowana</span>
                                }
                                else if (appointment.Status == ClinicSystem.Models.AppointmentStatus.Cancelled)
                                {
                                    <span class="badge bg-danger">Odwołana</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">Nieobecność</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state">
            <i class="bi bi-calendar-x"></i>
            <p>Ten lekarz nie ma jeszcze żadnych wizyt.</p>
        </div>
    }
</div>