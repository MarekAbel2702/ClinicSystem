@model ClinicSystem.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "Rejestracja";
    Layout = "~/Views/Shared/_PublicLayout.cshtml";
}

<section class="auth-section">
    <div class="auth-card auth-card-wide">
        <div class="auth-header">
            <div class="auth-icon">
                <i class="bi bi-person-plus"></i>
            </div>

            <h1>Rejestracja pacjenta</h1>
            <p>Utwórz konto pacjenta w systemie MediClinic.</p>
        </div>

        <form asp-action="Register" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="FirstName" class="form-label"></label>
                    <input asp-for="FirstName" class="form-control" placeholder="np. Jan" />
                    <span asp-validation-for="FirstName" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="LastName" class="form-label"></label>
                    <input asp-for="LastName" class="form-control" placeholder="np. Kowalski" />
                    <span asp-validation-for="LastName" class="text-danger"></span>
                </div>

                <div class="col-md-12">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" placeholder="pacjent@email.pl" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Pesel" class="form-label"></label>
                    <input asp-for="Pesel" class="form-control" placeholder="11 cyfr" maxlength="11" />
                    <span asp-validation-for="Pesel" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="DateOfBirth" class="form-label"></label>
                    <input asp-for="DateOfBirth" class="form-control" type="date" />
                    <span asp-validation-for="DateOfBirth" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="PhoneNumber" class="form-label"></label>
                    <input asp-for="PhoneNumber" class="form-control" placeholder="np. 500 600 700" />
                    <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Address" class="form-label"></label>
                    <input asp-for="Address" class="form-control" placeholder="np. ul. Zdrowa 12, Warszawa" />
                    <span asp-validation-for="Address" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password" class="form-control" placeholder="Minimum 6 znaków" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="ConfirmPassword" class="form-label"></label>
                    <input asp-for="ConfirmPassword" class="form-control" placeholder="Powtórz hasło" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>
            </div>

            <button type="submit" class="btn btn-primary w-100 mt-4">
                <i class="bi bi-person-check"></i>
                Utwórz konto
            </button>
        </form>

        <div class="auth-footer">
            <p>Masz już konto?</p>
            <a asp-controller="Account" asp-action="Login">
                Zaloguj się
            </a>
        </div>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}