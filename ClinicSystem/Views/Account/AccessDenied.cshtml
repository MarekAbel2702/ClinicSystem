@{
    ViewData["Title"] = "Brak dostępu";
    Layout = "~/Views/Shared/_PublicLayout.cshtml";
}

<section class="auth-section">
    <div class="auth-card">
        <div class="auth-header">
            <div class="auth-icon danger-auth-icon">
                <i class="bi bi-exclamation-triangle"></i>
            </div>

            <h1>Brak dostępu</h1>
            <p>Nie masz uprawnień do wyświetlenia tej części systemu.</p>
        </div>

        <a asp-controller="Home" asp-action="Index" class="btn btn-light w-100 mb-2">
            Wróć na stronę główną
        </a>

        <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary w-100">
            Przejdź do panelu
        </a>
    </div>
</section>