@model ClinicSystem.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Logowanie";
    Layout = "~/Views/Shared/_PublicLayout.cshtml";
}

<section class="auth-section">
    <div class="auth-card">
        <div class="auth-header">
            <div class="auth-icon">
                <i class="bi bi-shield-lock"></i>
            </div>

            <h1>Logowanie</h1>
            <p>Zaloguj się do systemu MediClinic.</p>
        </div>

        <form asp-action="Login" method="post">
            <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" placeholder="admin@mediclinic.pl" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" placeholder="Wpisz hasło" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="form-check mb-4">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label"></label>
            </div>

            <button type="submit" class="btn btn-primary w-100">
                <i class="bi bi-box-arrow-in-right"></i>
                Zaloguj się
            </button>
        </form>

        <div class="auth-footer">
            <p>Nie masz konta?</p>
            <a asp-controller="Account" asp-action="Register">
                Utwórz konto pacjenta
            </a>
        </div>

        <div class="demo-login-box">
            <strong>Konto testowe administratora:</strong>
            <span>E-mail: admin@mediclinic.pl</span>
            <span>Hasło: Admin123</span>
        </div>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}